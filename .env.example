# ============================================================================
# qoorag 环境变量模板（.env.example）
#
# 使用方式：
#   cp .env.example .env      # 然后填入真实密钥
#
# .env 会被 DotenvEnvironmentPostProcessor 在启动时自动读取（工作目录或 jar 同级目录），
# 同时也是 docker-compose.yml 的 env_file 来源——宿主机开发与容器部署共用一份配置。
# 优先级：OS 环境变量 / -D 参数  >  .env  >  application.yml 默认值
# 安全：.env 已被 .gitignore 忽略；本模板只含占位符，可安全提交。
# ============================================================================

# ---------------------------------------------------------------------------
# 基础设施（对应本工程 docker-compose.yml，容器名 qoorag-postgres / qoorag-redis）
# 宿主端口刻意用 5433 / 6380，避免与机器上其他项目的 5432 / 6379 冲突。
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=qoorag
DB_USERNAME=qoorag
DB_PASSWORD=your_db_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# 首次启动创建的管理员密码（仅当库中无该账号时生效）。
# 注意：不要用 123456 这类弱口令——部分工具链的密钥扫描器会把此类字面量
# 改写成占位符，导致落盘的 .env 与实际预期不符（本项目已踩此坑）。
ADMIN_DEFAULT_PASSWORD=your_admin_password

# 应用端口（仅容器部署时用到 APP_PORT，宿主机开发默认 8080）
APP_PORT=8080

# ---------------------------------------------------------------------------
# Chat 对话（问答生成 / Contextual Chunking 前缀 / 评测 Judge）
#
# 任何 OpenAI 兼容服务均可。示例：
#   阿里云百炼  base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
#              chat-model=qwen-plus
#   DeepSeek    base-url=https://api.deepseek.com
#              chat-model=deepseek-flash | deepseek-v4-pro
#   OpenAI      base-url=https://api.openai.com/v1
#              chat-model=gpt-4o-mini
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_llm_api_key
LLM_CHAT_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# Embedding 向量化（RAG 必需，不可缺省）
#
# 注意：DeepSeek 只提供 Chat 模型，不提供 embedding，必须另配 Provider。
# 更换模型通常伴随维度变化：vector_data.embedding 列维度由启动期
#   VectorDimensionReconciler 对齐（表为空时自动 ALTER；有数据时需人工处理）。
# ---------------------------------------------------------------------------
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_BATCH_SIZE=25

# ---------------------------------------------------------------------------
# Rerank 精排（可选）
# endpoint 常与 chat/embedding 不同域，故密钥单独拆出；留空则回退到 Embedding 密钥
# ---------------------------------------------------------------------------
RERANK_ENABLED=false
RERANK_API_KEY=
QOORAG_RERANK_ENDPOINT=
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=5

# ---------------------------------------------------------------------------
# 内容安全（可选，默认关闭）
# ---------------------------------------------------------------------------
CONTENT_SAFETY_ENABLED=false
CONTENT_SAFETY_ALIYUN_AK=
CONTENT_SAFETY_ALIYUN_SK=
